{
  "name": "loopback",
  "private": true,
  "version": "0.1.0",
  "description": "Commit-bound, auditable merge gate for AI-assisted bug fixing through Switch rooms",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "apps/switch-gate"
  ],
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrate": "node apps/switch-gate/dist/persistence/migrate-cli.js",
    "gate": "node apps/switch-gate/dist/main.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
