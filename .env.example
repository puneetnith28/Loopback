# Loopback gatekeeper configuration. Copy to .env and fill in; never commit .env.
# Each setting names the component that consumes it. Settings are validated per
# group when that component starts; a missing group disables its feature.

# --- Switch group (consumed by: switch transport, command router) -------------
SWITCH_BRIDGE_URL=                 # bridge base URL of the installed Switch version (verified on install)
# One-time setting: a Switch registration key, used only to register loopback-gate
# (POST /agents). Remove it from .env once SWITCH_AGENT_API_KEY is stored; secret.
# SWITCH_REGISTRATION_KEY=
SWITCH_AGENT_ID=                   # id returned when registering loopback-gate
SWITCH_AGENT_API_KEY=              # shown once at registration; secret
SWITCH_ROOM_ID=                    # the private loopback-maintainers room
SWITCH_INTAKE_ROOM_ID=             # the public bug-intake room; must differ from SWITCH_ROOM_ID
SWITCH_SELF_ID=                    # the gate's own participant id (loop prevention)
SWITCH_GATE_MENTION=@loopback-gate   # how messages address the gate (the registered agent name)
# The gate refuses to start unless its Switch addressing policy is exactly two rules (exit code 4):
#   1. rooms [SWITCH_ROOM_ID], users = SWITCH_POLICY_USER_IDS, agents = SWITCH_POLICY_AGENT_IDS
#   2. rooms [SWITCH_INTAKE_ROOM_ID], users "*", agents []
# with room_groups "*" and owner/owner_agents/platform false in both. It also refuses to start
# unless Switch offers the post_message and read_context operations (exit code 5).
SWITCH_POLICY_USER_IDS=            # ExternalUser ids (UUIDs) of the maintainers who may address the gate
SWITCH_POLICY_AGENT_IDS=           # Switch agent ids (UUIDs) of the fixer and verifier

# --- Identity group (consumed by: policy/authorize, approvals, verification) ---
LOOPBACK_MAINTAINERS=              # comma-separated participant ids from `whoami`
LOOPBACK_REPORTERS=                # explicit comma-separated participant ids; `*` is rejected
LOOPBACK_FIXER_ID=                 # fixer agent participant id
LOOPBACK_VERIFIER_ID=              # verifier agent participant id
LOOPBACK_FIXER_ALIAS=@loopback-fixer
LOOPBACK_VERIFIER_ALIAS=@loopback-verifier
LOOPBACK_PRIVILEGED_ENABLED=false  # verify/approve/reject/merge/retask; leave false until the identity checks in docs/setup.md pass
VERIFIER_ISOLATION_PROVEN=false    # true only once the container isolation and signer proofs pass with the verifier's own Switch and GitHub credentials (docs/setup.md); until then verification is labelled advisory
# D28 isolated mode (all required when VERIFIER_ISOLATION_PROVEN=true; the gate refuses to start otherwise):
VERIFIER_PUBLIC_KEY=               # the verifier SIGNER's Ed25519 PUBLIC key (deploy/isolation/agents.sh signer-init prints it): raw 32-byte base64 or PEM; never a private key
LOOPBACK_RUN_ISSUER_KEY_PATH=      # D29: absolute path of the gate's Ed25519 run-issuer PRIVATE key (mode 600, e.g. <repo>/secrets/run-issuer.pem); signs the per-run capability the signer requires
LOOPBACK_FIXER_AGENT_ID=           # Switch agent id (UUID) of the fixer; must be in SWITCH_POLICY_AGENT_IDS
LOOPBACK_VERIFIER_AGENT_ID=        # Switch agent id (UUID) of the verifier; must be in SWITCH_POLICY_AGENT_IDS and differ from the fixer's
INTAKE_MAX_REPORTS_PER_HOUR=3      # public intake reports accepted per sender per hour

# --- GitHub group (consumed by: github client, poller, merge gate) ------------
GH_REPO=                           # owner/repo of the demo repository
GH_APP_ID=
GH_APP_INSTALLATION_ID=
GH_APP_PRIVATE_KEY_PATH=./secrets/gate.pem   # file mode 600; its directory must not be group- or world-writable (secrets/ is 700). Windows: locked with icacls and outside OneDrive (docs/windows.md)
BASE_BRANCH=main                   # exact base branch; during demo runs demo/<DEMO_RUN_ID>
REQUIRED_CHECKS=test
CHECK_SOURCES=test:github-actions  # check name : app slug
REQUIRED_CHECK_INTEGRATIONS=       # check context : ruleset integration id (e.g. test:15368); loopback/gate is bound automatically to GH_APP_ID
GATE_STATUS_CONTEXT=loopback/gate
DEMO_RUN_ID=                       # optional; <yyyymmdd>-<16 hex>; requires DEMO_RESET_SHA
DEMO_RESET_SHA=                    # full SHA the run branch was created from

# --- Runtime group (consumed by: main, persistence, merge gate, sweeps) -------
DB_PATH=./data/loopback.db         # must not be in OneDrive on Windows (docs/windows.md)
MERGE_ENABLED=false                # true only after branch protection is proven
POLL_INTERVAL_MS=10000
VERIFY_TIMEOUT_MS=600000
FIX_TIMEOUT_MS=2700000
TRANSIENT_RETRY_LIMIT=3
MERGE_MAX_ATTEMPTS=2
QUORUM=1
LOG_LEVEL=info
# /healthz and /readyz, bound to 127.0.0.1 only. No inline comment here: node --env-file keeps a
# comment on the file's last setting as part of its value.
HTTP_PORT=8787
